# ─── FilmVault Backend Environment Variables ───
# Copy this file to .env and fill in your values

# MongoDB Connection String
# Local:   mongodb://localhost:27017/filmvault
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/filmvault
MONGODB_URI=mongodb://localhost:27017/filmvault

# JWT Secret — use any long random string
JWT_SECRET=filmvault_super_secret_key_change_this_in_production

# Server Port
PORT=5000

# TMDb API Key (optional — for server-side poster fetching)
TMDB_API_KEY=your_tmdb_api_key_here
